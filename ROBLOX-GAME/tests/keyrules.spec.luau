local KeyRules = require("../src/shared/KeyRules")
local Inventory = require("../src/shared/Inventory")

local function never()
	return 1
end
local function always()
	return 0
end

return function(t)
	t.test("only single-door classrooms, computer rooms and the gym are keyed", function()
		t.eq(KeyRules.isKeyed("normal", 1), true)
		t.eq(KeyRules.isKeyed("computer", 1), true)
		t.eq(KeyRules.isKeyed("gym", 1), true)
		t.eq(KeyRules.isKeyed("normal", 2), false, "a passage room stays open")
		t.eq(KeyRules.isKeyed("wc", 1), false)
		t.eq(KeyRules.isKeyed("library", 1), false)
		t.eq(KeyRules.doorCount("S10.8 n41.3"), 2)
		t.eq(KeyRules.doorCount("S"), 1)
		t.eq(KeyRules.doorCount(""), 0)
	end)

	t.test("room key ids", function()
		t.eq(KeyRules.itemId("GT11-12"), "roomkey:GT11-12")
		t.eq(KeyRules.roomOf("roomkey:23"), "23")
		t.eq(KeyRules.roomOf("key"), nil, "the storage key is not a room key")
		t.eq(Inventory.nameOf("roomkey:23"), "Key 23")
		t.eq(Inventory.isSmall("roomkey:23"), true, "fits a pocket")
		t.eq(Inventory.lookOf("roomkey:23"), "key")
	end)

	t.test("one key at a time when he remembers", function()
		local ledger = KeyRules.newLedger()
		local ok = KeyRules.ask(ledger, "23", {}, 0, false, never)
		t.eq(ok, true)
		local again, line = KeyRules.ask(ledger, "24", { "23" }, 1, false, never)
		t.eq(again, false)
		t.truthy(string.find(line, "room 23", 1, true), line)
		local same = KeyRules.ask(ledger, "23", { "23" }, 2, false, always)
		t.eq(same, false, "never the same key twice")
	end)

	t.test("sometimes he forgets and hands over another", function()
		local ledger = KeyRules.newLedger()
		KeyRules.ask(ledger, "23", {}, 0, false, never)
		local ok, line = KeyRules.ask(ledger, "24", { "23" }, 1, false, always)
		t.eq(ok, true, line)
		local third = KeyRules.ask(ledger, "GT5", { "23", "24" }, 2, false, always)
		t.eq(third, true, "and again: more than a few keys")
		t.eq(ledger.out["GT5"], true)
		t.eq(ledger.out["23"], nil, "the older ones are forgotten")
	end)

	t.test("an answer stands for a while, then he can be asked again", function()
		local ledger = KeyRules.newLedger()
		KeyRules.ask(ledger, "23", {}, 0, false, never)
		t.eq((KeyRules.ask(ledger, "24", { "23" }, 1, false, never)), false)
		t.eq((KeyRules.ask(ledger, "24", { "23" }, 5, false, always)), false, "asking again at once: same answer")
		t.eq((KeyRules.ask(ledger, "24", { "23" }, 1 + KeyRules.RECALL + 1, false, always)), true, "later: a new roll")
	end)

	t.test("at night every key", function()
		local ledger = KeyRules.newLedger()
		KeyRules.ask(ledger, "23", {}, 0, true, never)
		t.eq((KeyRules.ask(ledger, "24", { "23" }, 1, true, never)), true)
	end)

	t.test("keys go back any time, all at once", function()
		local ledger = KeyRules.newLedger()
		KeyRules.ask(ledger, "23", {}, 0, false, never)
		local line = KeyRules.giveBack(ledger, { "23", "GT5" })
		t.truthy(string.find(line, "2 keys", 1, true), line)
		t.eq(next(ledger.out), nil)
		t.eq((KeyRules.ask(ledger, "24", {}, 1, false, never)), true, "free to borrow again")
	end)

	t.test("nothing to give back", function()
		local ledger = KeyRules.newLedger()
		t.truthy(string.find(KeyRules.giveBack(ledger, {}), "door", 1, true))
		KeyRules.ask(ledger, "23", {}, 0, false, never)
		t.truthy(string.find(KeyRules.giveBack(ledger, {}), "room 23", 1, true), "he still remembers the lost one")
	end)

	t.test("carried and takeAll find keys in the hand, pockets and worn bag", function()
		local inv = Inventory.new()
		Inventory.add(inv, { id = "salt" })
		Inventory.add(inv, { id = "roomkey:23" })
		inv.bag = { { id = "roomkey:24" }, { id = "fuse" } }
		t.eq(#Inventory.carried(inv, KeyRules.isKey), 2)
		inv.bagWorn = false
		t.eq(#Inventory.carried(inv, KeyRules.isKey), 1, "a dropped bag is not on you")
		inv.bagWorn = true
		local taken = Inventory.takeAll(inv, KeyRules.isKey)
		t.eq(#taken, 2)
		t.eq(#inv.bag, 1)
		t.eq(inv.pocketL, nil)
		t.eq(inv.hand and inv.hand.id, "salt")
	end)
end
