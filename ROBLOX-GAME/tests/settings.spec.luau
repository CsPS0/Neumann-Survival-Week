local Settings = require("../src/shared/Settings")

return function(t)
	t.test("defaults", function()
		local d = Settings.clean(nil)
		t.eq(d.fov, 70)
		t.eq(d.sensitivity, 1)
		t.eq(d.volume, 0.8)
		t.eq(d.showFps, false)
	end)
	t.test("clamps and rounds to the steps", function()
		local s = Settings.clean({ fov = 200, sensitivity = 0.01, volume = 0.83, showFps = true })
		t.eq(s.fov, 100)
		t.eq(s.sensitivity, 0.2)
		t.near(s.volume, 0.8, 1e-9)
		t.eq(s.showFps, true)
	end)
	t.test("ignores junk", function()
		local s = Settings.clean({ fov = "x", sensitivity = {}, volume = nil, showFps = "yes", extra = 5 })
		t.eq(s.fov, 70)
		t.eq(s.sensitivity, 1)
		t.eq(s.volume, 0.8)
		t.eq(s.showFps, false)
		t.eq((s :: any).extra, nil)
	end)
	t.test("step", function()
		t.eq(Settings.step("fov", 70, 1), 75)
		t.eq(Settings.step("fov", 100, 1), 100)
		t.near(Settings.step("volume", 0, -1), 0, 1e-9)
		t.near(Settings.step("sensitivity", 1, 1), 1.1, 1e-9)
	end)
	t.test("lobby codes", function()
		t.eq(Settings.cleanCode(" ab7kq "), "AB7KQ")
		t.eq(Settings.cleanCode("ab7k"), nil)
		t.eq(Settings.cleanCode("AB7K!"), nil)
		t.eq(Settings.cleanCode(nil), nil)
		local code = Settings.newCode(function(n) return n end)
		t.eq(#code, 5)
		t.eq(Settings.cleanCode(code), code)
	end)
end
