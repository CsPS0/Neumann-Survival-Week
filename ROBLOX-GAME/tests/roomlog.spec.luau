local RoomLog = require("../src/shared/RoomLog")

return function(t)
	t.test("records changes only and keeps the window", function()
		local log = RoomLog.new()
		log:record("Student 1", "14 (ground floor)", 0)
		log:record("Student 1", "14 (ground floor)", 5)
		log:record("Student 1", "Corridor (ground floor)", 30)
		log:record("Student 1", "WC (1st floor)", 80)
		local r = log:recent("Student 1", 100, 60)
		t.eq(#r, 2)
		t.eq(r[1].label, "Corridor (ground floor)")
		t.eq(r[2].label, "WC (1st floor)")
		t.eq(#log:recent("nobody", 100, 60), 0)
		t.eq(#log:recent("Classmate A", 100, 60), 0) -- a late student's body in Social Deduction
		log:clear()
		t.eq(#log:recent("Student 1", 100, 60), 0)
	end)
	t.test("a player who never moved still shows their room", function()
		local log = RoomLog.new()
		log:record("Teacher 2", "Porta (ground floor)", 0)
		local r = log:recent("Teacher 2", 300, 60)
		t.eq(#r, 1)
		t.eq(r[1].label, "Porta (ground floor)")
	end)
end
