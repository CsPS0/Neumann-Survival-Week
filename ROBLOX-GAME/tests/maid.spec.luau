local Maid = require("../src/shared/Maid")

return function(t)
	t.test("cleans every kind of task once", function()
		local log = {}
		local maid = Maid.new()
		maid:give(function()
			table.insert(log, "fn")
		end)
		maid:give({ Disconnect = function()
			table.insert(log, "conn")
		end })
		maid:give({ Destroy = function()
			table.insert(log, "inst")
		end })
		maid:clean()
		t.eq(#log, 3)
		maid:clean()
		t.eq(#log, 3)
	end)
	t.test("give returns the task and a failing task does not stop the others", function()
		local ran = false
		local maid = Maid.new()
		local task_ = maid:give(function()
			error("boom")
		end)
		t.eq(type(task_), "function")
		maid:give(function()
			ran = true
		end)
		maid:clean()
		t.eq(ran, true)
	end)
end
