local R = require("../src/shared/Rooms")

return function(t)
	t.test("kinds from the map", function()
		t.eq(R.typeOf("14"), "normal")
		t.eq(R.typeOf("GT5"), "computer")
		t.eq(R.typeOf("WC"), "wc")
		t.eq(R.typeOf("Tornaterem"), "gym")
		t.eq(R.typeOf("Porta"), "entrance")
		t.eq(R.typeOf("31"), "changing")
		t.eq(R.typeOf("Büfé"), "kitchen", "opened: the buffet counter")
		t.eq(R.isOpen("Büfé"), true)
		t.eq(R.typeOf("19"), "storage")
		t.eq(R.isOpen("229"), true)
		t.eq(R.typeOf("no such room"), "other")
	end)
	t.test("real names", function()
		t.eq(R.realName("201"), "Iskolatitkár")
		t.eq(R.realName("229"), "229")
	end)
end
