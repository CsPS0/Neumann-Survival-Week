{
  "name": "TheEmptySchool",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService",
        "CreateDefaultTextChannels": true
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CharacterJumpPower": 50
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true,
        "ClockTime": 0,
        "Brightness": 0.3,
        "Ambient": [0.1, 0.1, 0.13],
        "OutdoorAmbient": [0.09, 0.09, 0.12],
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true,
        "ExposureCompensation": 0.2
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.32,
          "Offset": 0,
          "Color": [0.11, 0.12, 0.16],
          "Decay": [0.05, 0.05, 0.08],
          "Glare": 0,
          "Haze": 1.2
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.7,
          "Size": 24,
          "Threshold": 1.4
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0,
          "Spread": 0.7
        }
      },
      "Depth": {
        "$className": "DepthOfFieldEffect",
        "$properties": {
          "FarIntensity": 0.12,
          "FocusDistance": 30,
          "InFocusRadius": 45,
          "NearIntensity": 0
        }
      },
      "Grade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0,
          "Contrast": 0.12,
          "Saturation": -0.18,
          "TintColor": [0.94, 0.97, 1.0]
        }
      }
    }
  }
}
