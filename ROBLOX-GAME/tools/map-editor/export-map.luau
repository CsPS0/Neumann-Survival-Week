-- Writes today's map (src/shared/FloorData.luau and the room kinds of Rooms.luau) for the map editor:
-- tools/map-editor/map-data.js, loaded by index.html with a plain <script> (works from file://, no server).
-- Run from ROBLOX-GAME/: `lune run tools/map-editor/export-map`.
local fs = require("@lune/fs")
local luau = require("@lune/luau")
local serde = require("@lune/serde")

local function load(path: string)
	return luau.load(fs.readFile(path), { debugName = path })()
end

local FloorData = load("src/shared/FloorData.luau")
local Rooms = load("src/shared/Rooms.luau")

-- Game room kinds -> the editor's types (import-map.luau maps them back).
local TYPE = {
	normal = "classroom", computer = "it", lab = "lab", office = "office", library = "library", wc = "wc", gym = "gym",
	changing = "changing", entrance = "entrance", dining = "dining", kitchen = "kitchen", storage = "storage",
	medical = "medical", corridor = "corridor", other = "closed",
}

local floors = {}
for i, floor in FloorData.FLOORS do
	local rooms = {}
	for _, r in floor.rooms do
		table.insert(rooms, {
			label = r.label,
			realName = Rooms.realName(r.label),
			type = TYPE[r.kind] or "closed",
			x0 = r.x0, y0 = r.y0, x1 = r.x1, y1 = r.y1,
			doors = r.doors,
		})
	end
	-- The stairwells (the same on every floor) as stair rooms, in this floor's plan units.
	for _, st in FloorData.STAIRS do
		local o = floor.origin
		table.insert(rooms, {
			label = "", realName = "", type = "stairs", doors = "",
			x0 = st.x0 / floor.scale + o.x, y0 = st.z0 / floor.scale + o.y,
			x1 = st.x1 / floor.scale + o.x, y1 = st.z1 / floor.scale + o.y,
		})
	end
	local function boxes(list)
		local out = {}
		for _, b in list do
			table.insert(out, { x0 = b.x0, y0 = b.y0, x1 = b.x1, y1 = b.y1 })
		end
		return out
	end
	local function points(list)
		local out = {}
		for _, p in list do
			table.insert(out, { x = p.x, y = p.y })
		end
		return out
	end
	floors[i] = {
		name = FloorData.FLOOR_NAMES[i],
		rect = { x0 = floor.core.x0, y0 = floor.core.y0, x1 = floor.core.x1, y1 = floor.core.y1 },
		rooms = rooms,
		solids = boxes(floor.solids),
		endWalls = boxes(floor.endWalls),
		lights = points(floor.lights),
		patrol = points(floor.patrol),
	}
end

local json = serde.encode("json", { version = 1, floors = floors }, true)
fs.writeFile("tools/map-editor/map-data.js",
	"// Generated by export-map.luau from FloorData.luau. Do not edit; the editor saves your changes separately.\n"
		.. "window.SCHOOL_MAP = " .. json .. ";\n")
print(`wrote tools/map-editor/map-data.js ({#floors} floors)`)
